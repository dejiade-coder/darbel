// =============================================================================
// Darbel — Prisma Schema (Phase 1)
// This schema mirrors database/01-schema.sql. The SQL files are the source
// of truth for RLS, triggers, and audit infrastructure; Prisma is the
// type-safe access layer.
//
// Convention: Prisma never owns the schema in production. Database migrations
// are managed via raw SQL in database/*.sql. Prisma `db pull` keeps this
// file in sync. Run `prisma generate` after any change.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Jurisdictions & Tenants
// -----------------------------------------------------------------------------

model Jurisdiction {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique @db.VarChar(10)
  name             String   @db.VarChar(120)
  countryCode      String   @map("country_code") @db.Char(2)
  currencyCode     String   @map("currency_code") @db.Char(3)
  phoneCountryCode String   @map("phone_country_code") @db.VarChar(5)
  timezone         String   @default("Africa/Lagos") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  tenants Tenant[]
  tradeCategories TradeCategory[]

  @@map("jurisdictions")
}

model Tenant {
  id                     String   @id @default(uuid()) @db.Uuid
  code                   String   @unique @db.VarChar(20)
  legalName              String   @map("legal_name") @db.VarChar(200)
  displayName            String   @map("display_name") @db.VarChar(120)
  jurisdictionId         String   @map("jurisdiction_id") @db.Uuid
  contactEmail           String   @map("contact_email")
  contactPhone           String?  @map("contact_phone") @db.VarChar(20)
  isPlatformOperator     Boolean  @default(false) @map("is_platform_operator")
  isActive               Boolean  @default(true) @map("is_active")
  paymentModel           String   @default("FINANCE_APPROVAL") @map("payment_model") @db.VarChar(20)
  checkboxPaidThreshold  Decimal? @map("checkbox_paid_threshold") @db.Decimal(14, 2)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  jurisdiction Jurisdiction    @relation(fields: [jurisdictionId], references: [id])
  users        User[]
  roles        Role[]
  settings     TenantSetting[]
  tradeCategoryFees TradeCategoryFee[]
  handlerRegistrations HandlerRegistration[]
  payments             Payment[]
  handlerDocuments      HandlerDocument[]
  medicalScreenings     MedicalScreening[]
  certificates          Certificate[]
  certificateDeliveries CertificateDelivery[]

  @@index([jurisdictionId])
  @@map("tenants")
}

model TenantSetting {
  tenantId     String   @map("tenant_id") @db.Uuid
  settingKey   String   @map("setting_key") @db.VarChar(80)
  settingValue Json     @map("setting_value")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()
  updatedBy    String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, settingKey])
  @@map("tenant_settings")
}

// -----------------------------------------------------------------------------
// IAM
// -----------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(40)
  description String
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @db.VarChar(40)
  displayName  String   @map("display_name") @db.VarChar(120)
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  tenantId     String?  @map("tenant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([code, tenantId], map: "roles_code_scope_unique")
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz()
  grantedBy    String?  @map("granted_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  email                String
  phone                String?   @db.VarChar(20)
  fullName             String    @map("full_name") @db.VarChar(200)
  passwordHash         String    @map("password_hash")
  passwordChangedAt    DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz()
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc         String?   @map("mfa_secret_enc")
  isActive             Boolean   @default(true) @map("is_active")
  isLocked             Boolean   @default(false) @map("is_locked")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz()
  failedLoginCount     Int       @default(0) @map("failed_login_count")
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz()
  lastLoginIp          String?   @map("last_login_ip") @db.Inet
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy            String?   @map("created_by") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  roles           UserRole[]
  sessions        Session[]
  passwordHistory PasswordHistory[]
  handlerRegistrations HandlerRegistration[] @relation("HandlerRegistrationRegistrar")
  recordedPayments     Payment[]             @relation("PaymentRecorder")
  uploadedDocuments    HandlerDocument[]
  collectedScreenings  MedicalScreening[] @relation("ScreeningCollector")
  enteredScreenings    MedicalScreening[] @relation("ScreeningEntry")
  reviewedScreenings   MedicalScreening[] @relation("ScreeningReviewer")
  issuedCertificates   Certificate[]      @relation("CertificateIssuer")
  revokedCertificates  Certificate[]      @relation("CertificateRevoker")
  certificateDeliveries CertificateDelivery[] @relation("CertificateDeliveryActor")

  @@unique([tenantId, email], map: "users_tenant_email_unique")
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  email         String
  tenantId      String?  @map("tenant_id") @db.Uuid
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent")
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(80)
  attemptedAt   DateTime @default(now()) @map("attempted_at") @db.Timestamptz()

  @@index([email, attemptedAt(sort: Desc)])
  @@index([ipAddress, attemptedAt(sort: Desc)])
  @@map("login_attempts")
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  tenantId       String?  @map("tenant_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  action         String   @db.VarChar(10)
  tableName      String   @map("table_name") @db.VarChar(80)
  recordId       String   @map("record_id")
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  changedFields  String[] @map("changed_fields")
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id") @db.Uuid

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([tableName, recordId])
  @@map("audit_log")
}

model SensitiveAccessLog {
  id                 BigInt   @id @default(autoincrement())
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  tenantId           String   @map("tenant_id") @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  accessedTable      String   @map("accessed_table") @db.VarChar(80)
  accessedRecordId   String   @map("accessed_record_id")
  accessedField      String   @map("accessed_field") @db.VarChar(80)
  purpose            String?
  ipAddress          String?  @map("ip_address") @db.Inet
  requestId          String?  @map("request_id") @db.Uuid

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("sensitive_access_log")
}

// -----------------------------------------------------------------------------
// Trade Categories (Phase 2 Slice 1)
// -----------------------------------------------------------------------------

model TradeCategory {
  id                  String   @id @default(uuid()) @db.Uuid
  jurisdictionId      String   @map("jurisdiction_id") @db.Uuid
  code                String   @db.VarChar(40)
  displayName         String   @map("display_name") @db.VarChar(120)
  sector              String   @db.VarChar(20)
  description         String?
  validityPeriodDays  Int      @default(365) @map("validity_period_days")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  jurisdiction Jurisdiction          @relation(fields: [jurisdictionId], references: [id])
  fees         TradeCategoryFee[]

  @@unique([jurisdictionId, code], map: "trade_categories_jurisdiction_code_unique")
  @@index([jurisdictionId])
  @@map("trade_categories")
}

model TradeCategoryFee {
  tenantId         String   @map("tenant_id") @db.Uuid
  tradeCategoryId  String   @map("trade_category_id") @db.Uuid
  feeAmount        Decimal  @map("fee_amount") @db.Decimal(14, 2)
  currency         String   @default("NGN") @db.Char(3)
  effectiveFrom    DateTime @default(now()) @map("effective_from") @db.Timestamptz()
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tradeCategory TradeCategory @relation(fields: [tradeCategoryId], references: [id], onDelete: Cascade)

  @@id([tenantId, tradeCategoryId])
  @@index([tenantId])
  @@map("trade_category_fees")
}

// -----------------------------------------------------------------------------
// Handler Registrations (Phase 2 Slice 2)
// -----------------------------------------------------------------------------

model HandlerRegistration {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  registrarUserId       String    @map("registrar_user_id") @db.Uuid
  registrarName         String    @map("registrar_name") @db.VarChar(200)
  registrarEmail        String    @map("registrar_email")
  registrarPhone        String?   @map("registrar_phone") @db.VarChar(20)
  registrationDate      DateTime  @default(now()) @map("registration_date") @db.Date
  firstName             String?   @map("first_name") @db.VarChar(100)
  lastName              String?   @map("last_name") @db.VarChar(100)
  phone                 String?   @db.VarChar(20)
  email                 String?
  gender                String?   @db.VarChar(40)
  tradeCategory         String?   @map("trade_category") @db.VarChar(120)
  businessName          String?   @map("business_name") @db.VarChar(200)
  businessAddress       String?   @map("business_address")
  passportPhotoReceived Boolean   @default(false) @map("passport_photo_received")
  uid                   String?   @unique @db.VarChar(12)
  uidIssuedAt           DateTime? @map("uid_issued_at") @db.Timestamptz()
  uidIssuedBy           String?   @map("uid_issued_by") @db.Uuid
  status                String    @default("DRAFT") @db.VarChar(40)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  submittedAt           DateTime? @map("submitted_at") @db.Timestamptz()
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrar User   @relation("HandlerRegistrationRegistrar", fields: [registrarUserId], references: [id])
  payments  Payment[]
  documents HandlerDocument[]
  medicalScreening MedicalScreening?
  certificates Certificate[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([registrarUserId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("handler_registrations")
}

model HandlerDocument {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  handlerRegistrationId String   @map("handler_registration_id") @db.Uuid
  documentType          String   @map("document_type") @db.VarChar(40)
  storageKey            String   @map("storage_key")
  originalFilename      String?  @map("original_filename")
  mimeType              String   @map("mime_type") @db.VarChar(80)
  sizeBytes             BigInt   @map("size_bytes")
  sha256Hash            String   @map("sha256_hash") @db.Char(64)
  uploadedBy            String   @map("uploaded_by") @db.Uuid
  uploadedAt            DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()
  notes                 String?

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handlerRegistration HandlerRegistration @relation(fields: [handlerRegistrationId], references: [id], onDelete: Cascade)
  uploader            User                @relation(fields: [uploadedBy], references: [id])

  @@index([handlerRegistrationId, uploadedAt(sort: Desc)])
  @@index([tenantId, uploadedAt(sort: Desc)])
  @@map("handler_documents")
}

model MedicalScreening {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  handlerRegistrationId String    @unique @map("handler_registration_id") @db.Uuid
  status                String    @default("SAMPLE_COLLECTED") @db.VarChar(40)
  sampleCollectedBy     String?   @map("sample_collected_by") @db.Uuid
  sampleCollectedAt     DateTime? @map("sample_collected_at") @db.Timestamptz()
  labResultSummary      String?   @map("lab_result_summary")
  mantouxResult         String?   @map("mantoux_result") @db.VarChar(30)
  mantouxIndurationMm   Int?      @map("mantoux_induration_mm")
  hepatitisBResult      String?   @map("hepatitis_b_result") @db.VarChar(30)
  hivResult             String?   @map("hiv_result") @db.VarChar(30)
  widalResult           String?   @map("widal_result") @db.VarChar(30)
  medicalOfficerNotes   String?   @map("medical_officer_notes")
  fitnessStatus         String?   @map("fitness_status") @db.VarChar(30)
  enteredBy             String?   @map("entered_by") @db.Uuid
  enteredAt             DateTime? @map("entered_at") @db.Timestamptz()
  reviewedBy            String?   @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNotes           String?   @map("review_notes")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handlerRegistration HandlerRegistration @relation(fields: [handlerRegistrationId], references: [id], onDelete: Restrict)
  collector           User?               @relation("ScreeningCollector", fields: [sampleCollectedBy], references: [id])
  entrant             User?               @relation("ScreeningEntry", fields: [enteredBy], references: [id])
  reviewer            User?               @relation("ScreeningReviewer", fields: [reviewedBy], references: [id])
  certificates        Certificate[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("medical_screenings")
}

model Certificate {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  handlerRegistrationId String    @map("handler_registration_id") @db.Uuid
  medicalScreeningId    String?   @map("medical_screening_id") @db.Uuid
  uid                   String    @unique @db.VarChar(12)
  status                String    @default("VALID") @db.VarChar(30)
  issuedBy              String?   @map("issued_by") @db.Uuid
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz()
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz()
  revokedBy             String?   @map("revoked_by") @db.Uuid
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz()
  revokeReason          String?   @map("revoke_reason")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handlerRegistration HandlerRegistration @relation(fields: [handlerRegistrationId], references: [id], onDelete: Restrict)
  medicalScreening    MedicalScreening?   @relation(fields: [medicalScreeningId], references: [id], onDelete: SetNull)
  issuer              User?               @relation("CertificateIssuer", fields: [issuedBy], references: [id])
  revoker             User?               @relation("CertificateRevoker", fields: [revokedBy], references: [id])
  deliveries          CertificateDelivery[]

  @@unique([handlerRegistrationId, status])
  @@index([tenantId, status, issuedAt(sort: Desc)])
  @@map("certificates")
}

model CertificateDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  certificateId  String   @map("certificate_id") @db.Uuid
  channel        String   @db.VarChar(20)
  deliveryStatus String   @default("RECORDED") @map("delivery_status") @db.VarChar(30)
  recipient      String?
  deliveryUrl    String?  @map("delivery_url")
  messagePreview String?  @map("message_preview")
  performedBy    String?  @map("performed_by") @db.Uuid
  performedAt    DateTime @default(now()) @map("performed_at") @db.Timestamptz()
  metadata        Json?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  actor       User?       @relation("CertificateDeliveryActor", fields: [performedBy], references: [id])

  @@index([tenantId, performedAt(sort: Desc)])
  @@index([certificateId, performedAt(sort: Desc)])
  @@map("certificate_deliveries")
}

// -----------------------------------------------------------------------------
// Payments (Phase 2 Slice 3)
// -----------------------------------------------------------------------------

model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  handlerRegistrationId String    @map("handler_registration_id") @db.Uuid
  amount                Decimal   @db.Decimal(14, 2)
  currency              String    @default("NGN") @db.Char(3)
  method                String    @db.VarChar(30)
  reference             String?   @db.VarChar(120)
  receiptNumber         String?   @map("receipt_number") @db.VarChar(120)
  status                String    @default("RECORDED") @db.VarChar(40)
  paidAt                DateTime  @default(now()) @map("paid_at") @db.Timestamptz()
  recordedBy            String?   @map("recorded_by") @db.Uuid
  recordedAt            DateTime  @default(now()) @map("recorded_at") @db.Timestamptz()
  approvedBy            String?   @map("approved_by") @db.Uuid
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz()
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handlerRegistration HandlerRegistration @relation(fields: [handlerRegistrationId], references: [id], onDelete: Restrict)
  recorder            User?               @relation("PaymentRecorder", fields: [recordedBy], references: [id])

  @@unique([tenantId, receiptNumber], map: "payments_tenant_receipt_unique")
  @@index([tenantId, paidAt(sort: Desc)])
  @@index([handlerRegistrationId, paidAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("payments")
}
