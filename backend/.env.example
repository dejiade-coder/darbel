# =============================================================================
# Darbel Backend — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
APP_NAME=Darbel
LOG_LEVEL=debug

# --- Database (application connection, NOT migrator) ---
# Use the darbel_app role which has NOBYPASSRLS
DATABASE_URL=postgresql://darbel_app:change_me@localhost:5432/darbel?schema=public&connection_limit=10

# --- Migrator (only used by Prisma migrations / scripts) ---
DATABASE_MIGRATOR_URL=postgresql://darbel_migrator:change_me@localhost:5432/darbel?schema=public

# --- JWT ---
# RS256: provide PEM keys (escape newlines as \n in env files)
# Or paste here as base64 and decode in config. For local dev, simpler HS256.
JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-32-byte-random-string-for-dev-only
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER=darbel
JWT_AUDIENCE=darbel-api

# --- Argon2 (password hashing) ---
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# --- MFA ---
MFA_ISSUER=Darbel
MFA_WINDOW=1

# --- Security ---
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SENSITIVE_PERMISSIONS=medical.view_sensitive

# --- Rate limiting (per IP, per minute) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Tenant context ---
# When TRUE, the API requires Tenant context header for non-platform operations.
ENFORCE_TENANT_CONTEXT=true
